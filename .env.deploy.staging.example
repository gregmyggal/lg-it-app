# ============================================================
# LG-IT App — Configuration de déploiement STAGING
# Copier en .env.deploy.staging et remplir les valeurs réelles
# (ne contient que des infos de connexion : les secrets de l'app
#  vont dans backend/.env, créé directement sur le serveur)
# ============================================================

# Connexion SSH OVH (Manager > Hébergement > FTP-SSH)
SSH_USER=lgit
SSH_HOST=ssh.cluster0XX.hosting.ovh.net

# Clone git de lg-it-app sur le serveur.
# Le dossier racine du Multisite OVH doit pointer sur ${REMOTE_PATH}/backend/public
REMOTE_PATH=/homez.XXX/lgit/lg-it-app-staging

# URL publique du site
SITE_URL=https://staging.lgit.be

# Branche déployée (le serveur fait un git pull de origin/<branche>)
GIT_BRANCH=master

# Binaire PHP CLI sur le serveur (vérifier avec `php -v` en SSH ; ex. php8.3)
PHP_BIN=php

# Commande composer sur le serveur
COMPOSER_CMD="php ~/composer.phar"

# URL de l'API injectée dans le build React (défaut : ${SITE_URL}/api)
# VITE_API_URL=https://staging.lgit.be/api
